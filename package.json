{
  "name": "mynonrev",
  "version": "2.0.0",
  "private": true,
  "description": "Offline-first PWA: an encrypted vault and one-tap launcher for airline nonrev travel portals.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "start": "node tools/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "stage": "node tools/stage.mjs",
    "cap:sync": "node tools/stage.mjs && cap sync ios",
    "cap:open": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-inappbrowser": "^8.26.1"
  }
}
